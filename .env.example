VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Required only for the seed script (scripts/seed-from-workbooks.mjs).
# Get from Supabase dashboard → Project Settings → API → service_role key.
# NEVER commit this value.
SUPABASE_SERVICE_ROLE_KEY=

# Watch Tracker — free API key from themoviedb.org (Settings → API), used to
# fetch show/movie/episode metadata + artwork.
VITE_TMDB_API_KEY=

# Gig Ops Mission Control (/gig-ops) — server-side only, used by
# api/gig-ops-reply.js to post replies straight to GitHub issue comments and
# to fetch the live BACKLOG.md. Fine-grained GitHub PAT scoped to the
# gig-tracker repo, Issues: Read and write. See the in-app Setup Guide tab
# for the click-by-click walkthrough.
GITHUB_TOKEN_GIG_OPS=
