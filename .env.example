VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Required only for the seed script (scripts/seed-from-workbooks.mjs).
# Get from Supabase dashboard → Project Settings → API → service_role key.
# NEVER commit this value.
SUPABASE_SERVICE_ROLE_KEY=

# Watch Tracker — free API key from themoviedb.org (Settings → API), used to
# fetch show/movie/episode metadata + artwork.
VITE_TMDB_API_KEY=

# Gig Ops Mission Control (/gig-ops) — server-side only, used by
# api/gig-ops-backlog.js to display the live BACKLOG.md from the private
# gig-tracker repo. Fine-grained GitHub PAT scoped to that repo with
# Contents: Read-only — it needs no write access at all (replies are relayed
# to GitHub by the Sidekick routine, never from the browser). See
# docs/GIG_OPS_SETUP.md for the click-by-click walkthrough.
GITHUB_TOKEN_GIG_OPS=
